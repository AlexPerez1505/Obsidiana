
SESSION_COOKIE=obsidiana_sesion

# ---------- Marketing y promociones (WhatsApp Business Cloud API) ----------
# log = modo de pruebas (no sale nada, queda "simulado"); meta = envío real.
WHATSAPP_DRIVER=log
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v26.0
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_PLANTILLA_PROMO=promo_cupon
WHATSAPP_PLANTILLA_IDIOMA=es_MX
WHATSAPP_PLANTILLA_CON_IMAGEN=true
WHATSAPP_PLANTILLA_BOTON_BAJA=true
# Números (E.164 sin +) que pueden recibir pruebas, separados por coma. Reemplázalo por el tuyo.
PROMO_NUMEROS_PRUEBA=5215500000000
PROMO_SOLO_NUMEROS_PRUEBA=true
PROMO_FRECUENCIA_HORAS=72
PROMO_MENSAJES_POR_MINUTO=60
PROMO_RESERVA_HORAS=168
PROMO_OFERTA_APLICA_IVA=false
