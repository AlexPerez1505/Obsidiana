    <script>\n
    (function () {\n
        document.querySelectorAll('[data-view-switch]').forEach(function (grupo) {\n
            var clave    = 'vista:' + grupo.dataset.viewSwitch;\n
            var lista    = document.querySelector('[data-view-list]');\n
            var tarjetas = document.querySelector('[data-view-cards]');\n
            if (!lista || !tarjetas) return;\n
\n
            function aplicar(vista) {\n
                var esLista = vista !== 'tarjetas';\n
                lista.style.display    = esLista ? '' : 'none';\n
                tarjetas.style.display = esLista ? 'none' : 'grid';\n
                grupo.querySelectorAll('button').forEach(function (b) {\n
                    b.classList.toggle('active', b.dataset.view === (esLista ? 'lista' : 'tarjetas'));\n
                });\n
                try { localStorage.setItem(clave, esLista ? 'lista' : 'tarjetas'); } catch (e) {}\n
            }\n
\n
            grupo.querySelectorAll('button').forEach(function (b) {\n
                b.addEventListener('click', function () { aplicar(b.dataset.view); });\n
            });\n
\n
            var guardada = 'lista';\n
            try { guardada = localStorage.getItem(clave) || 'lista'; } catch (e) {}\n
            aplicar(guardada);\n
        });\n
    })();\n
    </script>\n
            <script>\n
        (function () {\n
            /*\n
            | Se escucha en document y en fase de CAPTURA, por dos razones:\n
            |\n
            |  - Engancharse de inmediato, sin esperar DOMContentLoaded: para\n
            |    cuando este script corre, ese evento puede haber pasado ya.\n
            |  - El menú de tres puntos corta la propagación de los clics que\n
            |    ocurren dentro de él (para no cerrarse solo), así que en\n
            |    fase de burbuja el clic en "Eliminar" nunca llegaba aquí.\n
            */\n
            document.addEventListener('click', function (e) {\n
                const modal = document.getElementById('modalEliminar');\n
                if (!modal) return;\n
\n
                const boton = e.target.closest('[data-eliminar-movimiento]');\n
\n
                if (boton) {\n
                    const form = document.getElementById('formEliminar');\n
                    form.action = boton.dataset.url;\n
                    modal.querySelector('[data-folio-eliminar]').textContent = boton.dataset.folio;\n
                    modal.querySelector('#pinEliminar').value = '';\n
                    modal.showModal();\n
\n
                    return;\n
                }\n
\n
                // Clic en el fondo: el objetivo es el propio <dialog>.\n
                if (e.target === modal || e.target.closest('[data-cerrar-modal]')) {\n
                    modal.close();\n
                }\n
            }, true);\n
\n
                    })();\n
        </script>\n
    </body>\n
