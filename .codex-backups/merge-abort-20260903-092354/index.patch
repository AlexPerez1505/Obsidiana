+            <h1 class="ui-head-title">Nueva venta</h1>
+        </div>
+        <div class="ui-head">
+            <a href="#" class="ui-head-back" aria-label="Regresar">
+                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/></svg>
+            </a>
+            <h1 class="ui-head-title">Ventas</h1>
+            <span class="ui-head-count">24</span>
+            <div class="ui-head-actions">
+                <a href="#" class="ui-btn ghost sm">Exportar</a>
+                <a href="#" class="ui-btn sm">Nueva venta</a>
+            </div>
+        </div>
+    </section>
