diff --git a/public/css/ui.css b/public/css/ui.css
new file mode 100644
index 0000000..a789dfb
--- /dev/null
+++ b/public/css/ui.css
@@ -0,0 +1,423 @@
+/* =============================================================
+   Sistema de diseno compartido
+   -------------------------------------------------------------
+   Limpio, minimalista y moderno. Consume las variables de color
+   que ya define layouts/dashboard.blade.php (--surface, --text,
+   --muted, --border, --primary...), asi que funciona igual en
+   modo claro y oscuro sin duplicar nada.
+
+   Prefijo de clases: .ui-
+   ============================================================= */
+
+:root {
+    /* Escala de espaciado: multiplos de 4 */
+    --ui-1: 4px;
+    --ui-2: 8px;
+    --ui-3: 12px;
+    --ui-4: 16px;
+    --ui-5: 20px;
+    --ui-6: 24px;
+    --ui-8: 32px;
+
+    /* Radios */
+    --ui-r-sm: 8px;
+    --ui-r: 10px;
+    --ui-r-lg: 14px;
+    --ui-r-pill: 999px;
+
+    /* Tipografia: dos pesos, nada de 700/800 */
+    --ui-fs-xs: 12px;
+    --ui-fs-sm: 13px;
+    --ui-fs: 14px;
+    --ui-fs-lg: 16px;
+    --ui-fs-title: 17px;
+    --ui-fs-num: 22px;
+    --ui-w: 400;
+    --ui-w-b: 600;
+
+    /* Movimiento */
+    --ui-dur: .15s;
+    --ui-dur-slow: .22s;
+    --ui-ease: cubic-bezier(.23, 1, .32, 1);
+}
+
+/* ---------- Cabecera de pagina ---------- */
+.ui-head {
+    display: flex;
+    align-items: center;
+    gap: var(--ui-3);
+    margin-bottom: var(--ui-5);
+}
+.ui-head-back {
+    width: 34px;
+    height: 34px;
+    flex: 0 0 34px;
+    border: none;
+    background: transparent;
+    border-radius: var(--ui-r-sm);
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    color: var(--muted);
+    text-decoration: none;
+    cursor: pointer;
+    transition: background var(--ui-dur) ease, color var(--ui-dur) ease, transform .1s var(--ui-ease);
+}
+.ui-head-back:hover { background: var(--surface-2); color: var(--text); }
+.ui-head-back:active { transform: scale(.92); }
+.ui-head-back svg { width: 18px; height: 18px; }
+
+.ui-head-title {
+    margin: 0;
+    font-size: var(--ui-fs-title);
+    font-weight: var(--ui-w-b);
+    letter-spacing: -.01em;
+    color: var(--text);
+    min-width: 0;
+}
+.ui-head-count {
+    font-size: var(--ui-fs-xs);
+    font-weight: var(--ui-w-b);
+    color: var(--muted);
+    background: var(--surface-2);
+    padding: 2px 9px;
+    border-radius: var(--ui-r-pill);
+}
+.ui-head-actions { margin-left: auto; display: flex; align-items: center; gap: var(--ui-2); flex-wrap: wrap; }
+
+/* ---------- Pie de acciones ---------- */
+.ui-foot {
+    position: sticky;
+    bottom: 0;
+    z-index: 20;
+    display: flex;
+    justify-content: flex-end;
+    align-items: center;
+    gap: var(--ui-2);
+    margin-top: var(--ui-6);
+    padding: var(--ui-3) 0;
+    border-top: 1px solid var(--border);
+    background: color-mix(in srgb, var(--bg) 88%, transparent);
+    backdrop-filter: blur(10px);
+    -webkit-backdrop-filter: blur(10px);
+}
+.ui-foot-l { margin-right: auto; color: var(--muted); font-size: var(--ui-fs-sm); }
+
+/* ---------- Botones ---------- */
+.ui-btn {
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+    gap: var(--ui-2);
+    padding: 10px 18px;
+    border: 1px solid transparent;
+    border-radius: var(--ui-r);
+    font-family: inherit;
+    font-size: var(--ui-fs);
+    font-weight: var(--ui-w-b);
+    line-height: 1;
+    color: #fff;
+    background: var(--primary);
+    text-decoration: none;
+    cursor: pointer;
+    white-space: nowrap;
+    transition: background var(--ui-dur) ease, border-color var(--ui-dur) ease, color var(--ui-dur) ease, transform .1s var(--ui-ease);
+}
+.ui-btn:hover { background: var(--primary-strong); }
+.ui-btn:active { transform: scale(.98); }
+.ui-btn:focus-visible { outline: 2px solid var(--primary); outline-offset: 3px; }
+.ui-btn[disabled], .ui-btn.is-disabled { opacity: .55; pointer-events: none; }
+
+.ui-btn.ghost { background: transparent; color: var(--text); border-color: var(--border); }
+.ui-btn.ghost:hover { background: var(--surface-2); }
+.ui-btn.quiet { background: transparent; color: var(--muted); border-color: transparent; font-weight: var(--ui-w); }
+.ui-btn.quiet:hover { background: var(--surface-2); color: var(--text); }
+.ui-btn.danger { background: var(--danger); }
+.ui-btn.danger:hover { filter: brightness(.93); }
+.ui-btn.sm { padding: 8px 13px; font-size: var(--ui-fs-sm); }
+.ui-btn.block { width: 100%; }
+.ui-btn svg { width: 16px; height: 16px; }
+
+/* Boton solo icono */
+.ui-icon-btn {
+    width: 34px;
+    height: 34px;
+    border: 1px solid var(--border);
+    border-radius: var(--ui-r-sm);
+    background: var(--surface);
+    color: var(--muted);
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+    cursor: pointer;
+    transition: background var(--ui-dur) ease, color var(--ui-dur) ease, border-color var(--ui-dur) ease, transform .1s var(--ui-ease);
+}
+.ui-icon-btn:hover { background: var(--surface-2); color: var(--text); }
+.ui-icon-btn:active { transform: scale(.94); }
+.ui-icon-btn svg { width: 17px; height: 17px; }
+
+/* ---------- Tarjetas ---------- */
+.ui-card {
+    background: var(--surface);
+    border: 1px solid var(--border);
+    border-radius: var(--ui-r-lg);
+}
+.ui-card.pad { padding: var(--ui-5); }
+.ui-card-head {
+    padding: var(--ui-4) var(--ui-5) 0;
+    font-size: var(--ui-fs);
+    font-weight: var(--ui-w-b);
+    color: var(--text);
+    letter-spacing: -.01em;
+}
+.ui-card-body { padding: var(--ui-3) var(--ui-5) var(--ui-5); }
+.ui-card-foot {
+    padding: var(--ui-3) var(--ui-5);
+    border-top: 1px solid var(--border);
+    display: flex;
+    justify-content: flex-end;
+    gap: var(--ui-2);
+}
+
+/* ---------- Metricas ---------- */
+.ui-stats {
+    display: grid;
+    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
+    gap: var(--ui-3);
+    margin-bottom: var(--ui-5);
+}
+.ui-stat {
+    background: var(--surface);
+    border: 1px solid var(--border);
+    border-radius: var(--ui-r-lg);
+    padding: var(--ui-4) var(--ui-5);
+}
+.ui-stat .l {
+    display: block;
+    color: var(--muted);
+    font-size: var(--ui-fs-sm);
+    margin-bottom: var(--ui-2);
+}
+.ui-stat .n {
+    display: block;
+    font-size: var(--ui-fs-num);
+    font-weight: var(--ui-w-b);
+    line-height: 1.1;
+    color: var(--text);
+    letter-spacing: -.02em;
+}
+.ui-stat .d { display: block; margin-top: var(--ui-1); font-size: var(--ui-fs-xs); color: var(--muted); }
+
+/* ---------- Tablas ---------- */
+.ui-table-wrap { overflow-x: auto; }
+.ui-table { width: 100%; border-collapse: collapse; font-size: var(--ui-fs); }
+.ui-table th {
+    text-align: left;
+    padding: var(--ui-3) var(--ui-4);
+    color: var(--muted);
+    font-weight: var(--ui-w);
+    font-size: var(--ui-fs-sm);
+    border-bottom: 1px solid var(--border);
+    white-space: nowrap;
+}
+.ui-table td {
+    padding: var(--ui-3) var(--ui-4);
+    border-bottom: 1px solid var(--border);
+    vertical-align: middle;
+    color: var(--text);
+}
+.ui-table tbody tr:last-child td { border-bottom: none; }
+.ui-table tbody tr { transition: background var(--ui-dur) ease; }
+.ui-table tbody tr:hover td { background: var(--surface-2); }
+.ui-table .num { text-align: right; font-variant-numeric: tabular-nums; }
+.ui-table .strong { font-weight: var(--ui-w-b); }
+
+/* ---------- Badges ---------- */
+.ui-badge {
+    display: inline-flex;
+    align-items: center;
+    gap: var(--ui-1);
+    padding: 3px 10px;
+    border-radius: var(--ui-r-pill);
+    font-size: var(--ui-fs-xs);
+    font-weight: var(--ui-w-b);
+    background: var(--surface-2);
+    color: var(--muted);
+    white-space: nowrap;
+}
+.ui-badge .dot { width: 5px; height: 5px; border-radius: 50%; background: currentColor; }
+.ui-badge.ok { background: var(--green-soft); color: var(--green); }
+.ui-badge.info { background: var(--primary-soft); color: var(--primary); }
+.ui-badge.warn { background: var(--accent-soft); color: var(--accent); }
+.ui-badge.danger { background: var(--danger-soft); color: var(--danger); }
+
+/* ---------- Formularios ---------- */
+.ui-field { margin-bottom: var(--ui-4); }
+.ui-label {
+    display: block;
+    font-size: var(--ui-fs-sm);
+    font-weight: var(--ui-w-b);
+    color: var(--muted);
+    margin-bottom: var(--ui-2);
+}
+.ui-input, .ui-select, .ui-textarea {
+    width: 100%;
+    padding: 10px 12px;
+    border: 1px solid var(--border);
+    border-radius: var(--ui-r);
+    background: var(--surface);
+    color: var(--text);
+    font-family: inherit;
+    font-size: var(--ui-fs);
+    outline: none;
+    transition: border-color var(--ui-dur) ease, box-shadow var(--ui-dur) ease;
+}
+.ui-input::placeholder, .ui-textarea::placeholder { color: var(--muted); }
+.ui-input:hover, .ui-select:hover, .ui-textarea:hover { border-color: var(--muted); }
+.ui-input:focus, .ui-select:focus, .ui-textarea:focus {
+    border-color: var(--primary);
+    box-shadow: 0 0 0 3px var(--primary-soft);
+}
+.ui-textarea { resize: vertical; min-height: 84px; }
+.ui-hint { margin: var(--ui-2) 0 0; font-size: var(--ui-fs-xs); color: var(--muted); }
+.ui-error { margin: var(--ui-2) 0 0; font-size: var(--ui-fs-xs); color: var(--danger); }
+
+/* Buscador */
+.ui-search { position: relative; flex: 1; min-width: 200px; }
+.ui-search svg {
+    position: absolute;
+    left: 12px;
+    top: 50%;
+    transform: translateY(-50%);
+    width: 16px;
+    height: 16px;
+    color: var(--muted);
+    pointer-events: none;
+}
+.ui-search input {
+    width: 100%;
+    padding: 10px 12px 10px 36px;
+    border: 1px solid var(--border);
+    border-radius: var(--ui-r);
+    background: var(--surface);
+    color: var(--text);
+    font-family: inherit;
+    font-size: var(--ui-fs);
+    outline: none;
+    transition: border-color var(--ui-dur) ease, box-shadow var(--ui-dur) ease;
+}
+.ui-search input:focus { border-color: var(--primary); box-shadow: 0 0 0 3px var(--primary-soft); }
+
+/* Barra de herramientas */
+.ui-toolbar {
+    display: flex;
+    align-items: center;
+    gap: var(--ui-2);
+    flex-wrap: wrap;
+    margin-bottom: var(--ui-4);
+}
+
+/* Segmentos */
+.ui-seg {
+    display: inline-flex;
+    padding: 3px;
+    gap: 3px;
+    background: var(--surface-2);
+    border-radius: var(--ui-r);
+}
+.ui-seg button {
+    padding: 7px 14px;
+    border: none;
+    border-radius: var(--ui-r-sm);
+    background: transparent;
+    color: var(--muted);
+    font-family: inherit;
+    font-size: var(--ui-fs-sm);
+    font-weight: var(--ui-w-b);
+    cursor: pointer;
+    transition: background var(--ui-dur) ease, color var(--ui-dur) ease;
+}
+.ui-seg button:hover { color: var(--text); }
+.ui-seg button.active { background: var(--surface); color: var(--text); }
+
+/* ---------- Estado vacio ---------- */
+.ui-empty { text-align: center; padding: var(--ui-8) var(--ui-4); }
+.ui-empty svg { width: 30px; height: 30px; color: var(--muted); opacity: .6; }
+.ui-empty h3 { margin: var(--ui-3) 0 var(--ui-1); font-size: var(--ui-fs-lg); font-weight: var(--ui-w-b); color: var(--text); }
+.ui-empty p { margin: 0 0 var(--ui-4); font-size: var(--ui-fs); color: var(--muted); }
+
+/* ---------- Menu de acciones ---------- */
+.ui-menu { position: relative; display: inline-block; }
+.ui-menu-panel {
+    position: fixed;
+    min-width: 190px;
+    background: var(--surface);
+    border: 1px solid var(--border);
+    border-radius: var(--ui-r-lg);
+    box-shadow: var(--shadow);
+    padding: var(--ui-1);
+    z-index: 1000;
+    display: none;
+    transform-origin: top right;
+}
+.ui-menu-panel.open { display: block; animation: uiPop var(--ui-dur) var(--ui-ease); }
+@keyframes uiPop {
+    from { opacity: 0; transform: translateY(-5px) scale(.97); }
+    to { opacity: 1; transform: none; }
+}
+.ui-menu-item {
+    display: flex;
+    align-items: center;
+    gap: var(--ui-3);
+    width: 100%;
+    padding: 9px 11px;
+    border: none;
+    border-radius: var(--ui-r-sm);
+    background: none;
+    color: var(--text);
+    font-family: inherit;
+    font-size: var(--ui-fs-sm);
+    text-align: left;
+    text-decoration: none;
+    cursor: pointer;
+    transition: background var(--ui-dur) ease;
+}
+.ui-menu-item:hover { background: var(--surface-2); }
+.ui-menu-item svg { width: 16px; height: 16px; color: var(--muted); flex: 0 0 auto; }
+.ui-menu-item.danger { color: var(--danger); }
+.ui-menu-item.danger svg { color: var(--danger); }
+.ui-menu-sep { height: 1px; background: var(--border); margin: var(--ui-1) 7px; }
+
+/* ---------- Avisos ---------- */
+.ui-note {
+    padding: var(--ui-3) var(--ui-4);
+    border: 1px solid var(--border);
+    border-radius: var(--ui-r);
+    background: var(--surface);
+    font-size: var(--ui-fs-sm);
+    color: var(--text);
+    margin-bottom: var(--ui-4);
+}
+.ui-note.ok { border-color: var(--green); background: var(--green-soft); color: var(--green); }
+.ui-note.danger { border-color: var(--danger); background: var(--danger-soft); color: var(--danger); }
+.ui-note ul { margin: var(--ui-2) 0 0; padding-left: 18px; }
+
+/* ---------- Rejillas ---------- */
+.ui-grid-2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: var(--ui-4); }
+.ui-split { display: grid; grid-template-columns: 340px minmax(0, 1fr); gap: var(--ui-4); align-items: start; }
+@media (max-width: 1000px) { .ui-split { grid-template-columns: 1fr; } }
+
+/* ---------- Aparicion suave ---------- */
+.ui-in { animation: uiIn var(--ui-dur-slow) var(--ui-ease) both; }
+@keyframes uiIn {
+    from { opacity: 0; transform: translateY(6px); }
+    to { opacity: 1; transform: none; }
+}
+
+/* ---------- Accesibilidad ---------- */
+@media (prefers-reduced-motion: reduce) {
+    .ui-btn, .ui-icon-btn, .ui-head-back, .ui-table tbody tr,
+    .ui-input, .ui-select, .ui-textarea, .ui-search input,
+    .ui-menu-item, .ui-seg button { transition: none; }
+    .ui-menu-panel.open, .ui-in { animation: none; }
+}
